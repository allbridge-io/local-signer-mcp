LOCAL_SIGNER_TRANSPORT=stdio
LOCAL_SIGNER_HOST=127.0.0.1
LOCAL_SIGNER_PORT=3333
# PORT is used when LOCAL_SIGNER_PORT is unset.
LOCAL_SIGNER_TLS_CERT_PATH=
LOCAL_SIGNER_TLS_KEY_PATH=
LOCAL_SIGNER_TLS_PASSPHRASE=
# EVM: a key and an RPC per chain (upper-case Allbridge chain symbol or chain id)...
# LOCAL_SIGNER_EVM_PRIVATE_KEY_ARB=
# LOCAL_SIGNER_EVM_RPC_URL_ARB=
# ...and/or a default pair for the chains without their own key.
LOCAL_SIGNER_EVM_PRIVATE_KEY=
LOCAL_SIGNER_EVM_RPC_URL=
# More wallets: LOCAL_SIGNER_<FAMILY>_WALLET_<ID>_PRIVATE_KEY / _RPC_URL (EVM slots also take _CHAIN_ID / _CHAIN_SYMBOL).
LOCAL_SIGNER_SOL_PRIVATE_KEY=
LOCAL_SIGNER_SOL_RPC_URL=
LOCAL_SIGNER_TRX_PRIVATE_KEY=
LOCAL_SIGNER_TRX_RPC_URL=
LOCAL_SIGNER_STX_PRIVATE_KEY=
LOCAL_SIGNER_STX_RPC_URL=
LOCAL_SIGNER_SRB_PRIVATE_KEY=
LOCAL_SIGNER_SRB_RPC_URL=
LOCAL_SIGNER_SRB_NETWORK_PASSPHRASE=
# Sui: suiprivkey1... or 32-byte hex key; RPC is the gRPC-web base URL, e.g. https://fullnode.mainnet.sui.io
LOCAL_SIGNER_SUI_PRIVATE_KEY=
LOCAL_SIGNER_SUI_RPC_URL=
